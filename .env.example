# ============================================================
# Gowtham B Portfolio — contact form environment variables
#
# Copy this file to `.env` for LOCAL development ONLY:
#   cp .env.example .env
# Then fill in the values. NEVER commit `.env` (it is gitignored).
#
# On Vercel / Netlify, set the same variables in the dashboard
# (Settings -> Environment Variables) instead of using a .env file.
# ============================================================

# Resend API key — create at https://resend.com/api-keys
# Never expose this in frontend/browser code.
RESEND_API_KEY=

# Sender address used in the "From" header.
# Must come from a domain verified in your Resend account.
# Production example: contact@yourdomain.com
# Testing only (sends ONLY to your own account email): onboarding@resend.dev
CONTACT_FROM_EMAIL=

# Recipient that receives all contact submissions.
CONTACT_TO_EMAIL=gowtham.aiml07@gmail.com

# Port for the local dev server (optional).
# PORT=3000